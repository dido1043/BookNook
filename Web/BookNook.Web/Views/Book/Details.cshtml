@using BookNook.Data.DTO
@model BookDto

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>Book</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">@Html.DisplayNameFor(m => m.Title)</dt>
        <dd class="col-sm-10">@Model.Title</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(m => m.Author)</dt>
        <dd class="col-sm-10">@Model.Author</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(m => m.Genre)</dt>
        <dd class="col-sm-10">@Model.Genre</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(m => m.AvailableQuantity)</dt>
        <dd class="col-sm-10">@Model.AvailableQuantity</dd>
    </dl>
</div>

<div>
    <a asp-action="Edit" asp-route-id="@Model.Id">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>
