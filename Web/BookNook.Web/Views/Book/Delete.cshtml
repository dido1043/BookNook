@model BookNook.Data.DTO.BookDto
@{ ViewData["Title"] = "Delete Record"; }

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0 text-uppercase" style="color: #ff3333;">>> Delete_Record</h2>
    <a asp-action="Index" class="btn">> RETURN_TO_LIST</a>
</div>

<div class="card p-4 col-md-8" style="border-color: #ff3333;">
    <h4 class="text-uppercase mb-4">Are you sure you want to delete this?</h4>
    
    <dl class="row mb-4">
        <dt class="col-sm-3 text-uppercase">> Title</dt>
        <dd class="col-sm-9" style="color: #39FF14;">@Model.Title</dd>
        
        <dt class="col-sm-3 text-uppercase">> Author</dt>
        <dd class="col-sm-9" style="color: #39FF14;">@Model.Author</dd>
        
        <dt class="col-sm-3 text-uppercase">> Genre</dt>
        <dd class="col-sm-9" style="color: #39FF14;">@Model.Genre</dd>
        
        <dt class="col-sm-3 text-uppercase">> Price</dt>
        <dd class="col-sm-9" style="color: #39FF14;">€@Model.Price.ToString("F2")</dd>
    </dl>

    <form asp-action="Delete">
        <div asp-validation-summary="ModelOnly" class="text-uppercase fw-bold mb-3" style="color: #ff3333;"></div>
        
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn w-100" style="color: #ff3333; border-color: #ff3333;">> CONFIRM_DELETE</button>
    </form>
</div>