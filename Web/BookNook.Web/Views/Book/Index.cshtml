@model IEnumerable<BookNook.Data.DTO.BookDto>
@{ ViewData["Title"] = "Book Inventory"; }

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0 text-uppercase">>> System_Inventory</h2>
    <a asp-action="Create" class="btn">> ADD_RECORD</a>
</div>

<div class="card p-0">
    <div class="table-responsive">
        <table class="table table-dark mb-0">
            <thead>
                <tr style="border-bottom: 2px solid #39FF14;">
                    <th>TITLE</th>
                    <th>AUTHOR</th>
                    <th>GENRE</th>
                    <th class="text-center">QTY</th>
                    <th class="text-end">PRICE</th>
                    <th class="text-end">ACTIONS</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model) {
                    <tr style="border-bottom: 1px solid #222;">
                        <td>@item.Title</td>
                        <td style="color: #666;">@item.Author</td>
                        <td>@item.Genre</td>
                        <td class="text-center">@item.AvailableQuantity</td>
                        <td class="text-end" style="color: #39FF14;">€@item.Price.ToString("F2")</td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm py-0">> EDIT</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm py-0 text-danger" style="border-color: #ff3333;">> DEL</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>