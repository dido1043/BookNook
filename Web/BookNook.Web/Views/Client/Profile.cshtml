@using BookNook.Data.Models
@model BookNook.Web.Models.ProfileViewModel
@{
    ViewData["Title"] = "Profile";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0 text-uppercase">>> User_Profile [@Model.Name]</h2>
    <span class="badge @(Model.Role == "Admin" ? "bg-danger" : "bg-primary") fs-6">@Model.Role.ToUpper()</span>
</div>

<div class="card p-4 mb-4">
    <div class="row">
        <div class="col-md-6">
            <p class="mb-1 text-uppercase" style="color: #aaa;">> Full_Name</p>
            <h5 style="color: #39FF14;">@Model.Name</h5>

            <p class="mb-1 mt-3 text-uppercase" style="color: #aaa;">> Email</p>
            <h5 style="color: #39FF14;">@Model.Email</h5>
        </div>
        <div class="col-md-6">
            <p class="mb-1 text-uppercase" style="color: #aaa;">> Phone</p>
            <h5 style="color: #39FF14;">@Model.Phone</h5>

            <p class="mb-1 mt-3 text-uppercase" style="color: #aaa;">> Delivery_Address</p>
            <h5 style="color: #39FF14;">@(string.IsNullOrWhiteSpace(Model.DeliveryAddress) ? "—" : Model.DeliveryAddress)</h5>
        </div>
    </div>
</div>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0 text-uppercase">>> Order_History</h3>
    <a asp-controller="Orders" asp-action="Create" class="btn btn-success">> NEW_ORDER</a>
</div>

@if (!Model.Orders.Any())
{
    <div class="alert text-uppercase">
        [!] No orders found for this account.
    </div>
}
else
{
    <div class="table-responsive card p-0">
        <table class="table table-dark table-hover mb-0" style="background-color: transparent;">
            <thead>
                <tr style="border-bottom: 2px solid #39FF14;">
                    <th>ID</th>
                    <th>DATE</th>
                    <th>DELIVERY</th>
                    <th>STATUS</th>
                    <th class="text-end">TOTAL</th>
                    <th class="text-center">ACTION</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var order in Model.Orders)
                {
                    <tr style="border-bottom: 1px solid #444;">
                        <td>#@order.Id</td>
                        <td>@order.OrderDate.ToString("dd MMM yyyy HH:mm")</td>
                        <td>
                            @if (order.DeliveryMethod == DeliveryMethod.InStore)
                            {
                                <span>IN_STORE</span>
                            }
                            else
                            {
                                <span>DELIVERY</span>
                            }
                        </td>
                        <td>
                            @switch (order.Status)
                            {
                                case OrderStatus.New:
                                    <span class="badge bg-secondary">@order.Status.ToString().ToUpper()</span>
                                    break;
                                case OrderStatus.Confirmed:
                                    <span class="badge bg-primary">@order.Status.ToString().ToUpper()</span>
                                    break;
                                case OrderStatus.Fulfilled:
                                    <span class="badge bg-success">@order.Status.ToString().ToUpper()</span>
                                    break;
                                case OrderStatus.Rejected:
                                    <span class="badge bg-danger">@order.Status.ToString().ToUpper()</span>
                                    break;
                            }
                        </td>
                        <td class="text-end fw-bold">€@order.TotalSum.ToString("F2")</td>
                        <td class="text-center">
                            <a asp-controller="Orders" asp-action="Details" asp-route-id="@order.Id" class="btn btn-sm py-0">> VIEW</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
