@model BookNook.Web.Models.ReportViewModel
@{
    ViewData["Title"] = "System Reports";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0 text-uppercase">>> Data_Analysis_Console</h2>

    <a asp-action="ExportCsv"
       asp-route-startDate="@Model.StartDate?.ToString("yyyy-MM-dd")"
       asp-route-endDate="@Model.EndDate?.ToString("yyyy-MM-dd")"
       class="btn" style="color: #39FF14; border-color: #39FF14;">> EXPORT_CSV</a>
</div>

<form method="get" class="row g-3 mb-4 p-4 card align-items-end">
    <div class="col-md-4">
        <label class="form-label small text-uppercase">> Date_From</label>
        <input type="date" name="startDate" value="@Model.StartDate?.ToString("yyyy-MM-dd")" class="form-control" />
    </div>

    <div class="col-md-4">
        <label class="form-label small text-uppercase">> Date_To</label>
        <input type="date" name="endDate" value="@Model.EndDate?.ToString("yyyy-MM-dd")" class="form-control" />
    </div>

    <div class="col-md-4">
        <button type="submit" class="btn w-100">GENERATE_REPORT</button>
    </div>
</form>

<div class="row g-4">
    <div class="col-md-6">
        <div class="card p-0 h-100">
            <h4 class="p-3 mb-0 text-uppercase" style="border-bottom: 2px solid #444;">>> REVENUE_BY_GENRE</h4>

            @if (!Model.GenreStats.Any())
            {
                <div class="p-3 text-uppercase" style="color: #ff3333;">[!] NO DATA FOR SELECTED PERIOD</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-dark mb-0">
                        <thead>
                            <tr style="border-bottom: 2px solid #39FF14;">
                                <th>GENRE</th>
                                <th class="text-center">UNITS</th>
                                <th class="text-end">REVENUE</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var stat in Model.GenreStats)
                            {
                                <tr style="border-bottom: 1px solid #222;">
                                    <td class="fw-bold">@stat.Genre.ToUpper()</td>
                                    <td class="text-center">@stat.UnitsSold</td>
                                    <td class="text-end fw-bold" style="color: #39FF14;">€@stat.Revenue.ToString("F2")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <div class="col-md-6">
        <div class="card p-0 h-100">
            <h4 class="p-3 mb-0 text-uppercase" style="border-bottom: 2px solid #444;">>> TOP_5_SELLERS</h4>

            @if (!Model.TopBooks.Any())
            {
                <div class="p-3 text-uppercase" style="color: #ff3333;">[!] NO DATA FOR SELECTED PERIOD</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-dark mb-0">
                        <thead>
                            <tr style="border-bottom: 2px solid #39FF14;">
                                <th>TITLE</th>
                                <th>AUTHOR</th>
                                <th class="text-center">SOLD</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var book in Model.TopBooks)
                            {
                                <tr style="border-bottom: 1px solid #222;">
                                    <td class="text-truncate" style="max-width: 200px;" title="@book.Title">@book.Title</td>
                                    <td style="color: #666;">@book.Author</td>
                                    <td class="text-center fw-bold" style="color: #39FF14;">@book.UnitsSold</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>